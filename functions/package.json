{
  "name": "medminder-firebase-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf lib",
    "deploy": "firebase deploy --only functions:joinDataset,functions:loginWebWithSyncCode,functions:logoutWebSession,functions:revokeDataset,firestore:rules",
    "serve": "npm run build && firebase emulators:start --only functions,firestore"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^5.1.1"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
