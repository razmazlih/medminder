rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isDatasetActive(datasetId) {
      return exists(/databases/$(database)/documents/datasets_v2/$(datasetId)) &&
        get(/databases/$(database)/documents/datasets_v2/$(datasetId)).data.status == 'ACTIVE';
    }

    function isDatasetOwner(datasetId) {
      return isSignedIn() &&
        isDatasetActive(datasetId) &&
        get(/databases/$(database)/documents/datasets_v2/$(datasetId)).data.ownerUid == request.auth.uid;
    }

    function isWebDatasetMember(datasetId) {
      return isSignedIn() &&
        isDatasetActive(datasetId) &&
        exists(
          /databases/$(database)/documents/datasets_v2/$(datasetId)/webMembers/$(request.auth.uid)
        );
    }

    function canAccessDataset(datasetId) {
      return isDatasetOwner(datasetId) || isWebDatasetMember(datasetId);
    }

    match /datasets_v2/{datasetId} {
      allow read: if canAccessDataset(datasetId);
      allow create, update, delete: if false;

      match /records/{recordId} {
        allow read, write: if canAccessDataset(datasetId);
      }

      match /webMembers/{memberUid} {
        allow read, write: if false;
      }
    }

    match /appOwners_v2/{ownerUid} {
      allow read, write: if false;
    }

    // Full reset: legacy datasets are no longer accessible.
    match /datasets/{datasetId} {
      allow read, write: if false;
    }
  }
}
