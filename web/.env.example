# Firebase Web SDK config (same Firebase project as Android app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Region of callable functions (joinDataset)
VITE_FIREBASE_FUNCTIONS_REGION=us-central1

# Optional: fake cloud mode for local/e2e testing
# 1 = use in-memory fake cloud adapter instead of Firebase
VITE_USE_FAKE_CLOUD=0
